{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apitrain.com/schemas/mcp.schema.json",
  "title": "MCP Execution Schema",
  "description": "Model Context Protocol for execution pipelines",
  "type": "object",
  "properties": {
    "mcp_version": {
      "type": "string",
      "description": "Version of the MCP schema",
      "enum": ["1.0"]
    },
    "input_schema": {
      "type": "object",
      "description": "Schema for input data to the pipeline",
      "properties": {
        "prompt": {
          "type": "string",
          "description": "The prompt to execute"
        },
        "context": {
          "type": "object",
          "description": "Additional context variables"
        }
      },
      "required": ["prompt"]
    },
    "pipeline": {
      "type": "array",
      "description": "Sequence of steps to execute",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Step identifier"
          },
          "type": {
            "type": "string",
            "description": "Step type (e.g., validate, transform, respond)",
            "enum": ["validate", "transform", "http", "branch", "store", "respond"]
          }
        },
        "required": ["id", "type"],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "policies": {
      "type": "object",
      "description": "Execution policies",
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "description": "Maximum execution time in milliseconds"
        },
        "retry.max": {
          "type": "integer",
          "description": "Maximum number of retries"
        }
      },
      "additionalProperties": false
    },
    "secrets_ref": {
      "type": "array",
      "description": "References to secrets",
      "items": {
        "type": "string"
      },
      "additionalItems": false
    },
    "exposed": {
      "type": "boolean",
      "description": "Whether the pipeline is exposed to external systems"
    }
  },
  "required": ["mcp_version", "input_schema", "pipeline"],
  "additionalProperties": false
}
